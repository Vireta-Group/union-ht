# -------------------------------------------------------------------
# BLOCK SENSITIVE FILE TYPES  (added during multi-tenant Phase 0 / B5)
# The rewrite below only forwards *non-existent* paths to index.php,
# so any real file sitting in the webroot was served as-is. These rules
# close that hole: dumps, archives, logs and dotfiles are never served.
# Applies to Apache 2.4 and 2.2.
# -------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|dump|bak|old|orig|save|swp|log|ini|conf|env|sh|sql\.gz|tar|gz|zip)$">
    Require all denied
  </FilesMatch>
  # any dotfile (.env, .git, .htpasswd, ...)
  <FilesMatch "(?i)^\.">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|dump|bak|old|orig|save|swp|log|ini|conf|env|sh|tar|gz|zip)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "(?i)^\.">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  #RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
