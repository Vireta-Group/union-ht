# ---------------------------------------------------------------------------
# ViretaDev — .env template
# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env MUST stay outside version control and MUST be
# chmod 600: config.php reads it from inside the webroot (FCPATH), and the only
# thing keeping it off the internet is the nginx dotfile deny rule. If you can
# move it, you should — but you cannot, so treat the deny rule as load-bearing.
#
# There is no .env.example in the repo on purpose: this file is the template,
# .env is the real one. Do not put a working .env here.
# ---------------------------------------------------------------------------

# --- environment -------------------------------------------------------------
# development  = error reporting on, ?tenant=N available, *.local dev hosts
#                served, signup throttle OFF
# production   = error reporting off, ?tenant=N refused, /t_diag 404s,
#                signup throttle ON, index.php REFUSES TO BOOT if
#                APP_ENCRYPTION_KEY or APP_TENANT_APEX below are missing
#
# CI_ENV in the real environment does NOT override this. config.php's loader
# calls putenv() on every .env line, clobbering the process environment, and
# is_development reads that loader. To test production, edit this file and put
# it back.
APP_ENV=production

# Anything other than a non-empty, non-'false' value turns on the verbose
# error path. Keep it empty in production.
APP_DEBUG=

# --- required in production --------------------------------------------------
# Generate with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Changing it invalidates every session and any encrypted data. index.php
# returns 503 with a message naming this key if it is missing, still the old
# published default ('allion5'), or shorter than 32 characters.
APP_ENCRYPTION_KEY=

# The apex a tenant may live under, e.g. viretaup.com. Two jobs, and they are
# easy to confuse:
#   1. create_tenant() appends it when a parishad registers
#   2. Tenant_resolver::match_subdomain() strips it off the Host header and
#      looks up the BARE SLUG in tenant_domains
# Both rows are written on signup, so they do not need to be added by hand.
# Needs a wildcard DNS record (*.viretaup.com) and a wildcard certificate.
# An empty value disables subdomain matching entirely, which is correct on a
# machine that has no such domain — and makes signup refuse rather than mint a
# tenant nobody can reach.
#
# Locally this is set to `localhost`, so signup keeps working on a machine with
# no domain of its own: the database already holds kanchan.localhost,
# rupsha.localhost and test-union-2.localhost from before this key existed.
APP_TENANT_APEX=

# --- database ----------------------------------------------------------------
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vireta
DB_USER=vireta
DB_PASSWORD=

# --- optional ----------------------------------------------------------------
# bcrypt cost for new hashes. Floor is 12 regardless of what you set; 12 is
# ~190 ms per hash. Existing hashes are unaffected — a bcrypt hash records the
# cost it was made with, and is transparently upgraded on the owner's next
# successful login.
# APP_BCRYPT_COST=12

# Signup throttle, per IP. Enforced only when APP_ENV=production.
# APP_SIGNUP_MAX_ATTEMPTS=5
# APP_SIGNUP_WINDOW=3600

# Where CI3 writes session files. Defaults to the system temp dir, which on a
# VPS is often cleared by a reboot and sometimes not writable by the web user.
# Point it at a directory you own.
# APP_SESSION_PATH=/var/lib/htxvireta/sessions

# --- NID verification service -------------------------------------------------
# Endpoint for the national ID lookup the Sonod wizard calls before it will
# issue a certificate. POSTed with nid_no + dob, expects a JSON body carrying
# lastID and the name fields; see Getapi::m_api_data().
#
# EMPTY (the default) means "no service configured": Getapi serves a clearly
# labelled LOCAL MOCK so the wizard can be walked end to end offline. The mock
# is not a verification and says so in the payload (_mock: true) and in
# application/logs/. Never point production at nothing and expect real checks.
#
# Set this to the real service on a machine that can reach it. A set but
# UNREACHABLE value also falls back to the mock and logs why, so a wrong host
# shows up in the log instead of silently producing blank forms.
# APP_NID_API_URL=http://darkboy/api/nidVerify

# --- mail / brevo smtp --------------------------------------------------------
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact.viretadev@gmail.com
MAIL_FROM_NAME="Vireta Dev"
MAIL_TO_NOTIFY=
BREVO_API_KEY=
